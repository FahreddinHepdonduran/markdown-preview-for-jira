{
  "manifest_version": 3,
  "name": "Markdown Preview for Jira",
  "version": "1.0.0",
  "description": "Read .md attachments on a Jira issue without downloading them — rendered inline, with code, tables, diagrams and math.",
  "minimum_chrome_version": "110",
  "permissions": ["storage"],
  "host_permissions": [
    "*://*.atlassian.net/*",
    "*://*.atlassian.com/*",
    "*://*.jira.com/*"
  ],
  "optional_host_permissions": ["*://*/*"],
  "background": { "service_worker": "src/background.js" },
  "action": {
    "default_title": "Markdown Preview for Jira",
    "default_popup": "options/popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "128": "icons/icon128.png" }
  },
  "options_page": "options/options.html",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_scripts": [
    {
      "matches": ["*://*.atlassian.net/*", "*://*.atlassian.com/*", "*://*.jira.com/*"],
      "js": ["src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["viewer.html", "src/viewer.js", "src/viewer.css", "vendor/*", "vendor/fonts/*"],
      "matches": ["*://*.atlassian.net/*", "*://*.atlassian.com/*", "*://*.jira.com/*"]
    }
  ],
  "commands": {
    "open-md-panel": {
      "suggested_key": { "default": "Alt+Shift+M" },
      "description": "Show markdown attachments on this issue"
    }
  }
}
